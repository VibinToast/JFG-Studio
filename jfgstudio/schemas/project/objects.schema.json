{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "JFG-Studio levels/<name>/objects.json",
 "type": "object",
 "required": ["format", "objects"],
 "additionalProperties": false,
 "properties": {
  "format": {"const": 1},
  "objects": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["uid", "type", "pos"],
    "additionalProperties": false,
    "properties": {
     "uid": {"type": "string", "pattern": "^[A-Za-z0-9_\\-]+$", "description": "stable id inside the project"},
     "name": {"type": "string", "description": "editor label only"},
     "type": {"type": "string", "description": "stock:objtype/<id> or <mod>:kind/<name>"},
     "schema": {"type": "string", "description": "schema key when the type alone does not pick one (door, squadmember)"},
     "pos": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
     "size": {"type": "integer", "minimum": 10, "maximum": 255, "description": "entry size; taken from the stock base when omitted"},
     "fields": {"type": "object", "additionalProperties": {"type": "integer"}},
     "params": {"type": "string", "pattern": "^([0-9a-fA-F]{2})*$", "description": "raw parameters from entry offset 0x0A"},
     "stock": {
      "type": "object",
      "required": ["list", "entry"],
      "additionalProperties": false,
      "description": "base: a stock list entry, filled in from the user's catalog at build time",
      "properties": {"list": {"type": "integer", "minimum": 0}, "entry": {"type": "integer", "minimum": 0}}
     },
     "target": {"type": "string", "description": "exits: the level they lead to (pack:level/<name> or stock:level/<n>)"},
     "kindFields": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^pack:kind/"}, "description": "fields that name one of the pack's kinds (a squadron's baddyType): the build writes the kind's object id"},
     "group": {"type": "string", "description": "editor grouping (Hierarchy)"}
    }
   }
  }
 }
}
