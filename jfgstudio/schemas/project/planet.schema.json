{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "JFG-Studio planets/<name>.json",
 "type": "object",
 "required": ["format", "displayName", "entryLevel"],
 "additionalProperties": false,
 "properties": {
  "format": {"const": 1},
  "displayName": {"type": "object", "required": ["en"], "additionalProperties": {"type": "string", "minLength": 1}},
  "replaces": {"type": "string", "description": "stock:mappoint/<n>: the map point this planet takes over (an in-place edit). Without it the planet gets a point of its own (the port's planet registry: disc and routes)"},
  "fixedWorld": {"type": "integer", "minimum": 0, "maximum": 15, "description": "phase 0 only: the world number until the port's planet registry exists"},
  "disc": {
   "type": "object",
   "required": ["index", "x", "y", "radius"],
   "additionalProperties": false,
   "properties": {
    "index": {"type": "integer", "minimum": 0, "maximum": 10, "description": "take-over: the map disc to edit (8-10 are moons in the stock map); a point of its own: the stock disc whose textures it wears"},
    "colour": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}, "description": "a point of its own: the colour of its top layer"},
    "x": {"type": "integer"}, "y": {"type": "integer"},
    "radius": {"type": "integer", "minimum": 1},
    "orbitParent": {"type": "integer", "minimum": -1, "description": "-1 = a planet"},
    "baseTexture": {"type": "integer"}, "topTexture": {"type": "integer"}
   }
  },
  "scale": {"type": "number"},
  "routes": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["from", "dir", "back"],
    "additionalProperties": false,
    "properties": {
     "from": {"type": "string", "description": "stock:mappoint/<n> or pack:world/<name>"},
     "dir": {"enum": ["left", "right", "up", "down"]},
     "back": {"enum": ["left", "right", "up", "down"]},
     "corners": {"type": "array", "maxItems": 4, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}}}
    }
   }
  },
  "entryLevel": {
   "type": "object",
   "required": ["vela", "juno", "lupus"],
   "additionalProperties": false,
   "properties": {"vela": {"type": "string"}, "juno": {"type": "string"}, "lupus": {"type": "string"}}
  },
  "unlock": {
   "type": "object",
   "additionalProperties": false,
   "properties": {"newGame": {"type": "array", "items": {"enum": ["vela", "juno", "lupus"]}}}
  }
 }
}
