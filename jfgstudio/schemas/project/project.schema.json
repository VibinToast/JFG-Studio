{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "JFG-Studio project.json",
 "type": "object",
 "required": ["format", "id", "version", "name"],
 "additionalProperties": false,
 "properties": {
  "format": {"const": 1},
  "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.\\-]*$", "description": "mod id of the built pack; also the namespace of its content"},
  "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
  "name": {"type": "string", "minLength": 1},
  "authors": {"type": "array", "items": {"type": "string"}},
  "description": {"type": "string"},
  "minimumRecompVersion": {"type": "string"},
  "dependencies": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["id", "version"],
    "additionalProperties": false,
    "properties": {
     "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.\\-]*$"},
     "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
     "hash": {"type": "string"},
     "project": {"type": "string", "description": "Studio only: the dependency's project folder (relative to this one), to place its object types"},
     "mod": {"type": "string", "description": "Studio only: the folder of a mod that isn't a Studio project (its mod.toml and jfg_assets.json), to place its object types"}
    }
   }
  }
 }
}
